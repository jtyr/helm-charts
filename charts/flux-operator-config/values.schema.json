{
  "$schema": "https://json-schema.org/schema#",

  "type": "object",
  "required": [
    "distribution",
    "components",
    "sync"
  ],
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object"
    },

    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "registry"
      ],
      "properties": {
        "version": {
          "type": "string"
        },

        "registry": {
          "type": "string"
        }
      }
    },

    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },

    "sync": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "url",
        "ref",
        "path",
        "pullSecret"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "generic",
            "aws",
            "azure",
            "gcp",
            "github"
          ]
        },

        "url": {
          "type": "string"
        },

        "ref": {
          "type": "string"
        },

        "path": {
          "type": "string"
        },

        "pullSecret": {
          "type": "string",
          "regexp": "^(?=.{1,63}$)(?:[a-z0-9]|[a-z0-9][-a-z0-9]*[a-z0-9]?[^-])$"
        },

        "decryptionSecret": {
          "type": "string"
        }
      }
    }
  }
}
