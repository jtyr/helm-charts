{
  "$schema": "https://json-schema.org/schema#",

  "type": "object",
  "required": [
    "email",
    "cloudflareTokenSecret",
    "dnsZones",
    "certificate"
  ],
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object"
    },

    "email": {
      "type": "string"
    },

    "cloudflareTokenSecret": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "key"
      ],
      "properties": {
        "name": {
          "type": "string",
          "regexp": "^(?=.{1,63}$)(?:[a-z0-9]|[a-z0-9][-a-z0-9]*[a-z0-9]?[^-])$"
        },

        "key": {
          "type": "string"
        }
      }
    },

    "dnsZones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },

    "certificate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issuer",
        "secretName",
        "namespace",
        "dnsNames"
      ],
      "properties": {
        "issuer": {
          "type": "string",
          "enum": [
            "letsencrypt-staging",
            "letsencrypt-prod"
          ]
        },

        "secretName": {
          "type": "string",
          "regexp": "^(?=.{1,63}$)(?:[a-z0-9]|[a-z0-9][-a-z0-9]*[a-z0-9]?[^-])$"
        },

        "namespace": {
          "type": "string",
          "regexp": "^(?=.{1,63}$)(?:[a-z0-9]|[a-z0-9][-a-z0-9]*[a-z0-9]?[^-])$"
        },

        "dnsNames": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
